    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import math\n",
    "\n",
    "#declaring parameters\n",
    "x = np.linspace(10e-16, 5.0, 100)\n",
    "y1 = (np.exp(x) - 1)/ x\n",
    "y2 = (np.expm1(x))/ x\n",
    "\n",
    "#for plotting\n",
    "fig, ax = plt.subplots(figsize = (7,6))\n",
    "ax.scatter(x, y1, label = r'f(x)')\n",
    "ax.scatter(x, y2, label = r'new f(x)')\n",
    "ax.set_ylabel('y')\n",
    "ax.set_xlabel('x')\n",
